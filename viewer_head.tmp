<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>灵阅书屋 · 阅读�?/title>
  <link rel="stylesheet" href="assets/style.css" />
  <script>
    const FS = { small: 16, medium: 19, large: 22 };
    const BUILTINS = [
      { key: '凡人修仙�?, manifest: '凡人修仙�?manifest.json' },
      { key: '凡人修仙传·仙界篇', manifest: '凡人修仙传·仙界篇/manifest.json' },
    ];

    const state = {
      mode: null,        // 'builtin' | 'server' | 'upload'
      bookKey: null,     // builtin key or 'srv:<id>' or 'upload:<id>'
      serverId: null,
      chapters: [],
      currentIndex: 0,
      font: 'medium',
      api: false,
      userName: null,
      cache: new Map(),
      manifests: {},
      encoding: 'utf-8',
    };

    function el(id){ return document.getElementById(id); }
    async function pingAPI(){ const c=new AbortController(); setTimeout(()=>c.abort(),800); try{ const r=await fetch('/api/health',{signal:c.signal}); state.api=r.ok; }catch{ state.api=false; } }
    async function authMe(){ if(!state.api) return null; try{ const r=await fetch('/api/auth/me'); if(!r.ok) return null; const j=await r.json(); if(j&&j.ok&&j.loggedIn){ state.userName=j.username; } }catch{} }
    function setFont(key){ state.font=FS[key]? key : 'medium'; document.documentElement.style.setProperty('--content-size', FS[state.font]+'px'); try{ localStorage.setItem('novel:fs', state.font);}catch{} }
    function saveLast(){ try{ localStorage.setItem('novel:last', JSON.stringify({ book: state.bookKey, index: state.currentIndex })); }catch{} }
    function saveProgress(){ try{ localStorage.setItem('novel:p:'+state.bookKey, String(state.currentIndex)); }catch{} }
    async function saveProgressServer(){ if(!state.api || !state.userName) return; try{ await fetch('/api/progress',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({book: state.bookKey, index: state.currentIndex})}); }catch{} }
    async function fetchJSON(url){ const r=await fetch(url); if(!r.ok) throw new Error('加载失败 '+url); return await r.json(); }
    async function fetchText(url, encoding='utf-8'){
      // 对非 UTF-8 文本�?TextDecoder 解码
      const enc = String(encoding||'utf-8').toLowerCase();
      if(enc==='utf-8' || enc==='utf8'){ const r=await fetch(url); if(!r.ok) throw new Error('加载失败 '+url); return await r.text(); }
      const r = await fetch(url); if(!r.ok) throw new Error('加载失败 '+url);
      const buf = await r.arrayBuffer();
      const mapped = (enc==='gb2312'||enc==='gbk')? 'gb18030' : enc;
      const dec = new TextDecoder(mapped, { fatal:false });
      return dec.decode(buf);
    }

    async function loadBuiltinsManifests(){ for(const b of BUILTINS){ try{ state.manifests[b.key]=await fetchJSON(b.manifest); }catch{} } }

    async function resolveFromParams(){
      const p = new URLSearchParams(location.search);
      const book = p.get('book');
      const srv = p.get('srv');
      const up = p.get('upload');
      if (book) { state.mode='builtin'; state.bookKey=book; return; }
      if (srv)  { state.mode='server'; state.serverId=String(srv); state.bookKey='srv:'+state.serverId; return; }
      if (up)   { state.mode='upload'; state.bookKey='upload:'+String(up); return; }
      // fallback to last
      try{ const last = JSON.parse(localStorage.getItem('novel:last')||'null'); if(last&&last.book){ state.bookKey=last.book; if(/^srv:\d+/.test(last.book)){ state.mode='server'; state.serverId=last.book.replace(/^srv:/,''); } else if(/^upload:/.test(last.book)){ state.mode='upload'; } else { state.mode='builtin'; } state.currentIndex = Number(last.index)||0; return; } }catch{}
      // fallback builtin
      state.mode='builtin'; state.bookKey=BUILTINS[0].key;
    }

    async function loadChapters(){
      if(state.mode==='builtin'){
        const mf = BUILTINS.find(b=>b.key===state.bookKey);
        const m = state.manifests[state.bookKey] || (mf? await fetchJSON(mf.manifest) : null);
        state.encoding = (m&&m.encoding)||'utf-8';
        state.chapters = Array.isArray(m?.chapters)? m.chapters.map(c=>({ index:c.index, title:c.title, file:c.file })) : [];
        state.currentIndex = state.currentIndex || (state.chapters[0]?.index || 0);
      } else if (state.mode==='server') {
        const j = await fetchJSON(`/api/books/${encodeURIComponent(state.serverId)}`);
        if(!j||!j.ok) throw new Error('服务器书籍不存在');
        state.chapters = (j.chapters||[]).map(c=>({ index:c.index, title:c.title }));
        state.currentIndex = state.currentIndex || (state.chapters[0]?.index || 0);
      } else if (state.mode==='upload') {
        const id = state.bookKey.replace(/^upload:/,'');
        const mani = JSON.parse(sessionStorage.getItem('upload:'+id+':manifest')||'null');
        if(!mani||!Array.isArray(mani.chapters)) throw new Error('上传会话已失�?);
        state.chapters = mani.chapters.map(c=>({ index:c.index, title:c.title }));
        state.currentIndex = state.currentIndex || (state.chapters[0]?.index || 0);
      }
    }

    function renderChapters(){ const sel=el('chapter'); sel.innerHTML=''; for(const c of state.chapters){ const o=document.createElement('option'); o.value=String(c.index); o.textContent=String(c.index).padStart(4,'0')+' · '+c.title; sel.appendChild(o); } sel.value=String(state.currentIndex); updateNav(); }
    function updateNav(){ if(!state.chapters.length){ el('prev').disabled=true; el('next').disabled=true; return; } const idxs=state.chapters.map(c=>c.index); const pos=idxs.indexOf(state.currentIndex); el('prev').disabled=pos<=0; el('next').disabled=pos<0||pos>=idxs.length-1; }

    function deriveTitle(text, fallback){
      try{
        const lines=String(text||'').split(/\r?\n/).map(s=>s.trim()).filter(Boolean);
        const re=/^(?:第[零一二三四五六七八九十百千万�?-9]+[章节回卷部集]\s*)?�?[零一二三四五六七八九十百千万�?-9]+[章节回][^\n\r]*$/;
        for(const s of lines){ if(re.test(s)) return s; }
        if(lines[0]) return lines[0].slice(0,60);
      }catch{}
      return fallback;
    }

    async function loadCurrent(){ const chap = state.chapters.find(c=>c.index===state.currentIndex) || state.chapters[0]; if(!chap) return; el('chapter').value=String(chap.index); el('title').textContent = chap.title; let text=''; try{ if(state.mode==='builtin'){ const url = state.bookKey + '/' + chap.file; text = await fetchText(url, state.encoding); } else if(state.mode==='server'){ const url = `/api/books/${encodeURIComponent(state.serverId)}/chapter/${encodeURIComponent(chap.index)}`; const r = await fetch(url); if(!r.ok) throw 0; text = await r.text(); } else { const id=state.bookKey.replace(/^upload:/,''); text = sessionStorage.getItem('upload:'+id+':ch:'+chap.index)||''; } }catch{ text=''; }
      const shownTitle = /�?.test(chap.title||'') ? deriveTitle(text, chap.title) : chap.title;
      el('title').textContent = shownTitle;
      try{ const sel=el('chapter'); const opt=[...sel.options].find(o=>o.value===String(chap.index)); if(opt){ opt.textContent=String(chap.index).padStart(4,'0')+' · '+shownTitle; } }catch{}
      el('content').textContent = text; window.scrollTo({top:0,behavior:'instant'});
      saveLast(); saveProgress(); saveProgressServer();
    }

    async function gotoPrev(){ const idxs=state.chapters.map(c=>c.index); const pos=idxs.indexOf(state.currentIndex); if(pos>0){ state.currentIndex=idxs[pos-1]; await loadCurrent(); } }
    async function gotoNext(){ const idxs=state.chapters.map(c=>c.index); const pos=idxs.indexOf(state.currentIndex); if(pos>=0 && pos<idxs.length-1){ state.currentIndex=idxs[pos+1]; await loadCurrent(); } }

    async function init(){
      try{ const saved=localStorage.getItem('novel:fs'); if(saved&&FS[saved]) state.font=saved; }catch{}
      document.documentElement.style.setProperty('--content-size', FS[state.font]+'px');
      await pingAPI(); await authMe();
      await loadBuiltinsManifests();
      await resolveFromParams();
      // restore local per-book progress if present
      try{ const p = Number(localStorage.getItem('novel:p:'+state.bookKey)||'0')||0; if(p) state.currentIndex=p; }catch{}
      await loadChapters();
      renderChapters();
      await loadCurrent();
      // events
      el('chapter').addEventListener('change', async ()=>{ state.currentIndex=Number(el('chapter').value); await loadCurrent(); });
      el('fs').addEventListener('change', ()=>{ setFont(el('fs').value); }); el('fs').value=state.font;
      el('prev').addEventListener('click', gotoPrev); el('next').addEventListener('click', gotoNext);
      document.addEventListener('keydown', (e)=>{ if(e.altKey||e.ctrlKey||e.metaKey||e.shiftKey) return; const tag=(e.target&&e.target.tagName||'').toLowerCase(); if(tag==='input'||tag==='textarea'||e.isComposing) return; if(e.key==='ArrowLeft'){ e.preventDefault(); gotoPrev(); } else if(e.key==='ArrowRight'){ e.preventDefault(); gotoNext(); } });
    }
    window.addEventListener('DOMContentLoaded', init);
  </script>
</head>
<body>
  <div class="topbar">
    <div class="container row">
      <a class="btn" href="/">�?返回首页</a>
      <div class="brand">灵阅书屋 · 阅读�?/div>
      <div class="spacer"></div>
    </div>
  </div>
  <div class="container reader-wrap">
    <div class="reader-header">
      <label>章节�?select id="chapter"></select></label>
      <label>字号�?select id="fs"><option value="small">�?/option><option value="medium">�?/option><option value="large">�?/option></select></label>
    </div>
    <div class="reader-content">
      <div class="reader-title" id="title"></div>
      <div id="content" style="white-space:pre-wrap; line-height:1.9"></div>
    </div>
    <div class="bottom-nav">
      <button class="btn nav-btn" id="prev">上一�?/button>
      <button class="btn nav-btn" id="next">下一�?/button>
    </div>
  </div>
  <div class="container footer">
    <div>QQ: 407292550 · WeChat: gdb1314_ · Email: yuhan.huang@whu.edu.cn</div>
  </div>
</body>
</html>
